+  version: 0.1.0
+  description: 'PROPOSED contract (see ADR 003). Owns reservations of resources defined by the Workplace
+    Spaces service: bookings, recurrence, group bookings, check-in and no-show release, booking policies,
+    administrative blocks, availability for map rendering, and utilisation facts. Resource identity and
+    access rules are read from Spaces over its API.'
+servers:
+- url: /
+security:
+- bearerAuth: []
+tags:
+- name: bookings
+- name: availability
+- name: policies
+- name: blocks
+- name: utilisation
+paths:
+  /v1/bookings:
+    get:
+      operationId: list_bookings
+      tags:
+      - bookings
+      summary: List bookings
+      x-brrtrouter-impl: true
+      parameters:
+      - $ref: '#/components/parameters/Page'
+      - $ref: '#/components/parameters/Limit'
+      - name: mine
+        in: query
+        schema:
+          type: boolean
+          default: true
+        description: Only the caller's bookings
+      - name: resource_id
+        in: query
+        schema:
+          type: string
+          format: uuid
+        description: Filter by resource
+      - name: floor_id
+        in: query
+        schema:
+          type: string
+          format: uuid
+        description: Filter by floor
+      - name: from
+        in: query
+        schema:
+          type: string
+          format: date-time
+        description: Window start
+      - name: to
+        in: query
+        schema:
+          type: string
+          format: date-time
+        description: Window end
+      - name: status
+        in: query
+        schema:
+          $ref: '#/components/schemas/BookingStatus'
+        description: Filter by status
+      responses:
+        '200':
+          description: Page of bookings
+          content:
+            application/json:
+              schema:
+                type: object
+                required:
+                - items
+                - total
+                - page
+                - limit
+                properties:
+                  items:
+                    type: array
+                    items:
+                      $ref: '#/components/schemas/Booking'
+                  total:
+                    type: integer
+                  page:
+                    type: integer
+                  limit:
