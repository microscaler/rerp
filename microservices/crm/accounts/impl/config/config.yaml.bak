# CRM pipeline service configuration (dev profile).
# The pipeline spec secures operations with bearerAuth. Until real IDAM
# arrives, the service runs BRRTRouter's static-signature bearer provider:
# set BRRTR_BEARER_SIGNATURE in the environment (k8s Secret) and give the
# portal the matching token. Do NOT put the real signature in this file.
security:
  api_keys: {}
  remote_api_keys: {}
  bearer:
    # signature comes from BRRTR_BEARER_SIGNATURE env; see deployment secret.
  oauth2: {}
  jwks: {}

http:
  keep_alive: true
  timeout_secs: 30
  max_requests: 5000

cors:
  # The portal normally reaches this service same-origin through the gateway
  # (/api/v1/crm/* on the pw-platform host). These origins cover direct calls
  # during development.
  origins:
    - "https://pw-platform.dev.microscaler.local"
    - "https://pw-trader.dev.microscaler.local"
    - "http://localhost:5173"
    - "http://localhost:3000"
  allowed_headers:
    - "Content-Type"
    - "Authorization"
  allowed_methods:
    - "GET"
    - "POST"
    - "PUT"
    - "DELETE"
    - "OPTIONS"
  allow_credentials: false
  expose_headers: []
  max_age: 600
